{
  "rules": {
    ".read": false,
    ".write": false,
    "p": {
      "$pid": {
        ".read": "$pid.length === 32",
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'ciao.abissostudio@gmail.com'",
        "m": {
          ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && newData.exists() && root.child('p').child($pid).child('m').child('ro').val() !== true",
          "title": {
            ".validate": "newData.isString() && newData.val().length < 300"
          },
          "ro": {
            ".validate": "auth != null && auth.token.email_verified === true && auth.token.email === 'ciao.abissostudio@gmail.com'"
          },
          "rc": {
            ".validate": "auth != null && auth.token.email_verified === true && auth.token.email === 'ciao.abissostudio@gmail.com'"
          },
          "n": {
            "$nid": {
              ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && (root.child('p').child($pid).child('m').child('ro').val() !== true || root.child('p').child($pid).child('m').child('rc').val() === true)",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 20000)"
            }
          }
        },
        "b": {
          ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && root.child('p').child($pid).child('m').child('ro').val() !== true",
          "$bid": {
            ".validate": "newData.hasChildren(['t','x','k']) && newData.child('t').isString() && newData.child('x').isString() && newData.child('x').val().length < 20000 && newData.child('k').isNumber()"
          }
        },
        "bd": {
          ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && root.child('p').child($pid).child('m').child('ro').val() !== true",
          ".validate": "newData.isString() && newData.val().length < 500000"
        },
        "u": {
          "$cid": {
            ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && root.child('p').child($pid).child('m').child('ro').val() !== true"
          }
        },
        "h": {
          "$hid": {
            ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && root.child('p').child($pid).child('m').child('ro').val() !== true && newData.exists() && (!data.exists() || data.child('start').val() === newData.child('start').val())"
          }
        },
        "s": {
          "$hid": {
            ".write": "$pid.length === 32 && root.child('p').child($pid).child('m').exists() && root.child('p').child($pid).child('m').child('ro').val() !== true && newData.exists()",
            ".validate": "newData.isString() && newData.val().length < 2000000"
          }
        }
      }
    }
  }
}